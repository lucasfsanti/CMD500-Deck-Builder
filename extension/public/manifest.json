{
  "manifest_version": 3,
  "name": "Commander 500 Deckbuilder",
  "version": "0.1.0",
  "description": "Budget and legality tooling for Commander 500 / Commander 500 Duel decks on LigaMagic.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Commander 500 deckbuilder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ligamagic.com.br/*",
        "https://ligamagic.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.scryfall.com/*",
    "https://www.ligamagic.com.br/*",
    "https://ligamagic.com.br/*"
  ]
}
